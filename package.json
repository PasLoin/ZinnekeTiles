{
  "name": "zinneketiles",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:validate": "node tests/validate-style.mjs",
    "test:all": "vitest run && node tests/validate-style.mjs && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "serve": "npx serve www -l 8080"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.4",
    "vitest": "^3.2.1"
  }
}
